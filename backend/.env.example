# Finlux backend environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Server ---
PORT=3000

# --- Database (PostgreSQL 18.6) ---
DATABASE_URL=postgresql://user:password@localhost:5432/finlux

# --- AI / LLM provider (Google Gemini via @ai-sdk/google) ---
# Obtain a key from Google AI Studio. Referenced by name only; do not commit the value.
GOOGLE_GENERATIVE_AI_API_KEY=
