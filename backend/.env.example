# Finlux backend environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Server ---
PORT=3000
# Comma-separated allowlist of frontend origins permitted to call the API from
# the browser (CORS). Defaults to http://localhost:3001 (local dev) when unset.
CORS_ORIGIN=http://localhost:3001

# --- Database (PostgreSQL 18.6) ---
DATABASE_URL=postgresql://user:password@localhost:5432/finlux

# --- Authentication (JWT + bcrypt) ---
# Secret used to sign JWT access tokens. Use a long, random value. Never commit the real value.
JWT_SECRET=
# Access-token lifetime (e.g. 1h, 30m). Finlux uses a 1-hour access-only token.
JWT_EXPIRES_IN=1h
# bcrypt cost factor (number of salt rounds). Defaults to 12 when unset.
BCRYPT_SALT_ROUNDS=12

# --- AI / LLM provider (Google Gemini via @ai-sdk/google) ---
# Obtain a key from Google AI Studio. Referenced by name only; do not commit the value.
GOOGLE_GENERATIVE_AI_API_KEY=
# Gemini model id used by the conversational agent (provider: @ai-sdk/google).
# flash-lite has the highest free-tier daily quota. Note: gemini-2.5-flash-lite
# is no longer offered to new users — use gemini-3.5-flash-lite (provider's
# recommended successor).
AGENT_MODEL_ID=gemini-3.5-flash-lite
# Max number of prior conversation messages passed to the agent as context.
AGENT_CONTEXT_MAX_MESSAGES=20
# Base URL the agent's in-process MCP transaction tools call as an HTTP client
# of the transaction REST API (GET/POST/PUT/DELETE /transactions), forwarding
# the caller's JWT as `Authorization: Bearer`. Defaults to the app's own origin
# in the single in-process deployment.
TRANSACTION_API_BASE_URL=http://localhost:3000
# IANA time zone the agent's get-current-date tool uses to resolve "today" as a
# YYYY-MM-DD calendar day (so relative dates like "today"/"yesterday" are
# correct regardless of the server's local time zone). Defaults to America/Bogota.
AGENT_TIME_ZONE=America/Bogota
