# Finlux backend environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Server ---
PORT=3000

# --- Database (PostgreSQL 18.6) ---
DATABASE_URL=postgresql://user:password@localhost:5432/finlux

# --- Authentication (JWT + bcrypt) ---
# Secret used to sign JWT access tokens. Use a long, random value. Never commit the real value.
JWT_SECRET=
# Access-token lifetime (e.g. 1h, 30m). Finlux uses a 1-hour access-only token.
JWT_EXPIRES_IN=1h
# bcrypt cost factor (number of salt rounds). Defaults to 12 when unset.
BCRYPT_SALT_ROUNDS=12

# --- AI / LLM provider (Google Gemini via @ai-sdk/google) ---
# Obtain a key from Google AI Studio. Referenced by name only; do not commit the value.
GOOGLE_GENERATIVE_AI_API_KEY=
